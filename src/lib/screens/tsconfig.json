{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "checkJs": true,
    "paths": {
      "@/lib/appEnv": ["../appEnv"],
      "@/lib/appEnv/*": ["../appEnv/*"],
      "@/lib/defineConfig": ["../defineConfig"],
      "@/lib/defineConfig/*": ["../defineConfig/*"],
      "@/lib/districtMap": ["../districtMap"],
      "@/lib/districtMap/*": ["../districtMap/*"],
      "@/lib/domain": ["../domain"],
      "@/lib/domain/*": ["../domain/*"],
      "@/lib/domainAccess": ["../domainAccess"],
      "@/lib/domainAccess/*": ["../domainAccess/*"],
      "@/lib/errors": ["../errors"],
      "@/lib/errors/*": ["../errors/*"],
      "@/lib/libPackage": ["../libPackage"],
      "@/lib/libPackage/*": ["../libPackage/*"],
      "@/lib/pathPattern": ["../pathPattern"],
      "@/lib/pathPattern/*": ["../pathPattern/*"],
      "@/lib/plainObject": ["../plainObject"],
      "@/lib/plainObject/*": ["../plainObject/*"],
      "@/lib/stringCase": ["../stringCase"],
      "@/lib/stringCase/*": ["../stringCase/*"],
      "@lib-config/screens": ["../../config/lib/screens.config.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.mjs", "**/*.js"]
}
