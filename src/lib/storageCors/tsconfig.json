      ],
      "@/lib/analyticsConsent/*": [
        "../analyticsConsent/*"
      ],
      "@/lib/appEnv": [
        "../appEnv"
      ],
      "@/lib/appEnv/*": [
        "../appEnv/*"
      ],
      "@/lib/defineConfig": [
        "../defineConfig"
