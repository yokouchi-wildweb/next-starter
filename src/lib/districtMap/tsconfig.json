{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "checkJs": true,
    "paths": {
      "@/lib/libPackage": ["../libPackage"],
      "@/lib/libPackage/*": ["../libPackage/*"],
      "@/lib/stringCase": ["../stringCase"],
      "@/lib/stringCase/*": ["../stringCase/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.mjs", "**/*.js"]
}
