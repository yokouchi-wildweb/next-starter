{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "checkJs": true,
    "paths": {
      "@/lib/appEnv": ["../appEnv"],
      "@/lib/appEnv/*": ["../appEnv/*"],
      "@/lib/domain": ["../domain"],
      "@/lib/domain/*": ["../domain/*"],
      "@/lib/domainAccess": ["../domainAccess"],
      "@/lib/domainAccess/*": ["../domainAccess/*"],
      "@/lib/errors": ["../errors"],
      "@/lib/errors/*": ["../errors/*"],
      "@/lib/libPackage": ["../libPackage"],
      "@/lib/libPackage/*": ["../libPackage/*"],
      "@/lib/stringCase": ["../stringCase"],
      "@/lib/stringCase/*": ["../stringCase/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.mjs", "**/*.js"]
}
