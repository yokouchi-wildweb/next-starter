{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "checkJs": true,
    "paths": {
      "@/lib/appEnv": [
        "../appEnv"
      ],
      "@/lib/appEnv/*": [
        "../appEnv/*"
      ],
      "@/lib/browserStorage": [
        "../browserStorage"
      ],
      "@/lib/browserStorage/*": [
        "../browserStorage/*"
      ],
      "@/lib/errors": [
        "../errors"
      ],
      "@/lib/errors/*": [
        "../errors/*"
      ],
      "@/lib/unsavedGuard": [
        "../unsavedGuard"
      ],
      "@/lib/unsavedGuard/*": [
        "../unsavedGuard/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.mjs",
    "**/*.js"
  ]
}
