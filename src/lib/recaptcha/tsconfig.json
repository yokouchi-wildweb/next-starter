{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@/components/*": [
        "../../components/*"
      ],
      "@/lib/defineConfig": [
        "../defineConfig"
      ],
      "@/lib/defineConfig/*": [
        "../defineConfig/*"
      ],
      "@/lib/plainObject": [
        "../plainObject"
      ],
      "@/lib/plainObject/*": [
        "../plainObject/*"
      ],
      "@lib-config/recaptcha": [
        "../../config/lib/recaptcha.config.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ]
}
