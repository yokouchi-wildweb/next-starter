      ],
      "@/lib/appEnv/*": [
        "../appEnv/*"
      ],
      "@/lib/audit": [
        "../audit"
      ],
      "@/lib/audit/*": [
        "../audit/*"
      ],
      "@/lib/crud": [
        "../crud"
      ],
      "@/lib/crud/*": [
        "../crud/*"
      ],
      "@/lib/defineConfig": [
        "../defineConfig"
