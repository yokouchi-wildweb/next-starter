{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@/lib/appEnv": [
        "../appEnv"
      ],
      "@/lib/appEnv/*": [
        "../appEnv/*"
      ],
      "@/lib/backends": [
        "../backends"
      ],
      "@/lib/backends/*": [
        "../backends/*"
      ],
      "@/lib/defineConfig": [
        "../defineConfig"
      ],
      "@/lib/defineConfig/*": [
        "../defineConfig/*"
      ],
      "@/lib/errors": [
        "../errors"
      ],
      "@/lib/errors/*": [
        "../errors/*"
      ],
      "@/lib/messaging": [
        "../messaging"
      ],
      "@/lib/messaging/*": [
        "../messaging/*"
      ],
      "@/lib/plainObject": [
        "../plainObject"
      ],
      "@/lib/plainObject/*": [
        "../plainObject/*"
      ],
      "@/lib/templateVariables": [
        "../templateVariables"
      ],
      "@/lib/templateVariables/*": [
        "../templateVariables/*"
      ],
      "@lib-config/mail": [
        "../../config/lib/mail.config.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ]
}
