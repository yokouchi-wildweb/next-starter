{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@/lib/defineConfig": [
        "../defineConfig"
      ],
      "@/lib/defineConfig/*": [
        "../defineConfig/*"
      ],
      "@/lib/messaging": [
        "../messaging"
      ],
      "@/lib/messaging/*": [
        "../messaging/*"
      ],
      "@/lib/plainObject": [
        "../plainObject"
      ],
      "@/lib/plainObject/*": [
        "../plainObject/*"
      ],
      "@/lib/templateVariables": [
        "../templateVariables"
      ],
      "@/lib/templateVariables/*": [
        "../templateVariables/*"
      ],
      "@lib-config/mail": [
        "../../config/lib/mail.config.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ]
}
