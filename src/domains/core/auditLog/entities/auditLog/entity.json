    },
    {
      "name": "audit_logs_action_idx",
      "fields": [
        "action",
        "createdAt"
      ]
    },
    {
      "name": "audit_logs_created_at_idx",
      "fields": [
        "createdAt"
      ]
    },
    {
      "name": "audit_logs_batch_id_idx",
      "fields": [
        "batchId",
