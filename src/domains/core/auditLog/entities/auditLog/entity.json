        "type": "jsonb"
      }
    },
    {
      "name": "metadata",
      "column": {
        "type": "jsonb"
      }
    },
    {
      "name": "reason",
      "column": {
        "type": "text"
      }
    },
    {
      "name": "retentionDays",
      "column": {
        "type": "integer",
        "notNull": true
      }
    },
    {
      "name": "batchId",
      "column": {
        "type": "uuid"
      }
    },
    {
      "name": "createdAt",
      "column": {
        "type": "timestamp with time zone",
        "notNull": true,
        "default": {
          "sql": "now()"
        }
      }
    }
  ],
  "enums": [
