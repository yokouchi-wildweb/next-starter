      "column": {
        "type": "text",
        "notNull": true
      }
    },
    {
      "name": "targetId",
      "column": {
        "type": "text",
        "notNull": true
      }
    },
    {
      "name": "subjectUserId",
      "column": {
        "type": "text"
      }
    },
    {
      "name": "actorId",
      "column": {
        "type": "text"
      }
    },
    {
      "name": "actorType",
      "column": {
        "enum": "audit_actor_type",
        "notNull": true
      }
    },
    {
      "name": "action",
      "column": {
        "type": "text",
        "notNull": true
      }
    },
    {
      "name": "beforeValue",
      "column": {
        "type": "jsonb"
      }
    },
    {
      "name": "afterValue",
      "column": {
        "type": "jsonb"
      }
    },
    {
