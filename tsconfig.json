{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@lib-config/*": ["./src/config/lib/*.config.ts"],
      "@/business": ["./src/wiring/business.ts"],
      "@/domains/admin/*": ["./src/domains/core/admin/*"],
      "@/domains/accountLifecycle/*": ["./src/domains/core/accountLifecycle/*"],
      "@/domains/adminCommand/*": ["./src/domains/core/adminCommand/*"],
      "@/domains/analytics/*": ["./src/domains/core/analytics/*"],
      "@/domains/auditLog/*": ["./src/domains/core/auditLog/*"],
      "@/domains/bankTransferReview/*": ["./src/domains/core/bankTransferReview/*"],
      "@/domains/auth/*": ["./src/domains/core/auth/*"],
      "@/domains/coupon/*": ["./src/domains/core/coupon/*"],
      "@/domains/couponHistory/*": ["./src/domains/core/couponHistory/*"],
      "@/domains/interactionTracking/*": ["./src/domains/core/interactionTracking/*"],
      "@/domains/demo/*": ["./src/domains/core/demo/*"],
      "@/domains/legal/*": ["./src/domains/core/legal/*"],
      "@/domains/phoneVerification/*": ["./src/domains/core/phoneVerification/*"],
      "@/domains/milestone/*": ["./src/domains/core/milestone/*"],
      "@/domains/notification/*": ["./src/domains/core/notification/*"],
      "@/domains/notificationTemplate/*": ["./src/domains/core/notificationTemplate/*"],
      "@/domains/purchaseQuota/*": ["./src/domains/core/purchaseQuota/*"],
      "@/domains/purchaseRequest/*": ["./src/domains/core/purchaseRequest/*"],
      "@/domains/rateLimit/*": ["./src/domains/core/rateLimit/*"],
      "@/domains/referral/*": ["./src/domains/core/referral/*"],
      "@/domains/referralReward/*": ["./src/domains/core/referralReward/*"],
      "@/domains/setting/*": ["./src/domains/core/setting/*"],
      "@/domains/storageObject/*": ["./src/domains/core/storageObject/*"],
      "@/domains/user/*": ["./src/domains/core/user/*"],
      "@/domains/userAcquisition/*": ["./src/domains/core/userAcquisition/*"],
      "@/domains/userCounter/*": ["./src/domains/core/userCounter/*"],
      "@/domains/userProfile/*": ["./src/domains/core/userProfile/*"],
      "@/domains/userLineProfile/*": ["./src/domains/core/userLineProfile/*"],
      "@/domains/userXProfile/*": ["./src/domains/core/userXProfile/*"],
      "@/domains/userTag/*": ["./src/domains/core/userTag/*"],
      "@/domains/userGroup/*": ["./src/domains/core/userGroup/*"],
      "@/domains/wallet/*": ["./src/domains/core/wallet/*"],
      "@/domains/chatRoom/*": ["./src/domains/core/chatRoom/*"],
      "@/domains/walletHistory/*": ["./src/domains/core/walletHistory/*"],
      "@/domains/batchJob/*": ["./src/domains/core/batchJob/*"],
      "@/domains/messaging/*": ["./src/domains/core/messaging/*"],
      "@/domains/deviceFingerprint/*": ["./src/domains/core/deviceFingerprint/*"],
      "@/domains/fingerprintChallenge/*": ["./src/domains/core/fingerprintChallenge/*"],
      "@/domains/cronCheckpoint/*": ["./src/domains/core/cronCheckpoint/*"],
      "@/domains/incrementalRefresh/*": ["./src/domains/core/incrementalRefresh/*"],
      "@/domains/couponAttributionReward/*": ["./src/domains/core/couponAttributionReward/*"],
      "@/domains/pairedDevice/*": ["./src/domains/core/pairedDevice/*"],
      "@/domains/taskRun/*": ["./src/domains/core/taskRun/*"],
      "@/domains/userLoginEvent/*": ["./src/domains/core/userLoginEvent/*"],
      "@/domains/couponIssuerGrant/*": ["./src/domains/core/couponIssuerGrant/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "servers",
    "src/_stash",
    "src/domains/_template",
    "src/app/admin/_template",
    "TODO.md"
  ]
}
