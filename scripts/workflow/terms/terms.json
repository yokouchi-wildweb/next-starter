{
  "terms": [
    { "en": "district", "ja": "地区", "meaning": "一つの性質を持つまとまり(名前空間・増設点・持ち主の単位)。開閉の軸ではない", "decisions": ["D7", "D12"] },
    { "en": "district kind", "ja": "地区の種類", "meaning": "地区の種類(domains・lib・frame・featureGate・registry・wiring・proxies)。kind を単独で使わない", "decisions": ["D8", "D12"] },
    { "en": "featureGate", "ja": "門番", "meaning": "機能の定義を持ち、ドメインを開け閉めする唯一の地区", "decisions": ["D12"] },
    { "en": "gate", "ja": null, "meaning": "門番の API の入口の名前だけ(gate.enabled・useGate・gate.path・GateProvider)。検査の段には使わない", "decisions": ["D41"] },
    { "en": "feature", "ja": "機能", "meaning": "門番の開け閉めの単位(規則 1 つ)だけ。ドメインの意味では使わない", "decisions": ["D10", "D12"] },
    { "en": "domain", "ja": "ドメイン", "meaning": "業務の概念の単位 = src/domains/<domain>(ゲートを持つ唯一の地区の種類)", "decisions": ["D10", "D12", "D43"] },
    { "en": "application", "ja": "アプリ", "meaning": "1 つのリポで動く物(app は src/app に残る名前)。街は説明の比喩で識別子に入れない", "decisions": ["D12"] },
    { "en": "framework", "ja": "フレームワーク", "meaning": "Tier1 が配る、アプリの設計図", "decisions": ["D12"] },
    { "en": "region", "ja": "区画", "meaning": "fork が親のファイルに書ける範囲(可変域の 1 行がファイルの一部を指す時)", "decisions": ["D12", "D20"] },
    { "en": "skeleton", "ja": "骨組み", "meaning": "proxies の鎖の上流の手書きの並び(旧: 枠)", "decisions": ["D12"] },
    { "en": "extension point", "ja": "拡張点", "meaning": "5 つの変え方の 1〜4 で上流が宣言した点の総称(差替点・上書点・増設点・対置点)", "decisions": ["D17", "D21"] },
    { "en": "replace", "ja": "差替型", "meaning": "変え方 1: 持ち主の既定を fork の版に差し替える", "decisions": ["D20"] },
    { "en": "override", "ja": "上書型", "meaning": "変え方 2: 宣言されたキーだけを上書きする(旧: overlay)", "decisions": ["D20"] },
    { "en": "add", "ja": "増設型", "meaning": "変え方 3: 増設点に項目を足す", "decisions": ["D20"] },
    { "en": "counterpart", "ja": "対置型", "meaning": "変え方 4: 持ち主のファイルと対になる場所に自分の版の値のファイルを置く(src/config の設定値・根の CSS、旧: placement)", "decisions": ["D20"] },
    { "en": "self", "ja": "固有型", "meaning": "変え方 5: 各リポが自分の版を持つファイル", "decisions": ["D20"] },
    { "en": "replace point", "ja": "差替点", "meaning": "ちょうど 1 つ要る点(常設のドメインが既定を差し、fork は差し替える)", "decisions": ["D20", "D21", "D24"] },
    { "en": "override point", "ja": "上書点", "meaning": "上書型で宣言された点(上書きしてよいキー)", "decisions": ["D20", "D21"] },
    { "en": "receptacle", "ja": "増設点", "meaning": "0 個以上の項目を並べる点(旧: 受け口)。型 = 変え方、点 = 上流が宣言した場所", "decisions": ["D21", "D24"] },
    { "en": "counterpart point", "ja": "対置点", "meaning": "対置型で宣言された点", "decisions": ["D20", "D21"] },
    { "en": "intake", "ja": "可変域", "meaning": "fork が親の物を変えてよい所の全部(拡張点 ⊂ 可変域)", "decisions": ["D20"] },
    { "en": "plug", "ja": null, "meaning": "差す側の手書きの項目 <ドメイン>/plugs/<点の名前>/<名前>.ts(増設点 receptacle と対。extensions/ は持ち主の側の生成された一覧)。日本語は指示書の議会が決める", "decisions": ["D40"] },
    { "en": "phase", "ja": "段階", "meaning": "検査と生成をまとめて回す段(build・build:post・ship・forge:pre・forge:post・deploy・nightly)。--phase・phase.json", "decisions": ["D19", "D48"] },
    { "en": "config values", "ja": "設定値", "meaning": "src/config の値のファイル", "decisions": ["D19"] },
    { "en": "core", "ja": "core", "meaning": "Tier1 が配って持つ物の 1 義", "decisions": ["D19"] },
    { "en": "always-open", "ja": "常設", "meaning": "どの機能も載せない、常に開いたドメイン(明示の宣言)", "decisions": ["D19", "D24"] },
    { "en": "base", "ja": "分岐点", "meaning": "親との merge-base だけ(常設の意味では使わない)", "decisions": ["D19"] }
