# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# public
/public

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# intelliJ
/.idea/

# Firebase
/.firebase/
firebase-service-acount.json
.firebaserc
firebase-debug.log
firestore.indexes.json
apphosting.yaml
firestore.rules
# firebase.json と storage.rules は upstream が同梱する（Storage は全拒否のルール。src/lib/storage/README.md）

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright-mcp (ページスナップショットに秘密情報が混入する可能性があるためコミット禁止)
.playwright-mcp/

# Claude Code が生成する一時 worktree（リポジトリにコミットしない）
.claude/worktrees/

# Claude Code の個人用設定（マシンごと。許可モードは ~/.claude/settings.json で設定する）
.claude/settings.local.json

