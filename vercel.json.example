{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/dispatch/15m",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/dispatch/hourly",
      "schedule": "10 * * * *"
    },
    {
      "path": "/api/cron/dispatch/daily",
      "schedule": "0 18 * * *"
    }
  ]
}
