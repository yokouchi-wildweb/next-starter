# servers/room/wrangler.toml.example
#
# Cloudflare Workers デプロイ設定の雛形。
# 有効化するフォークはこのファイルを wrangler.toml にコピーして使う (pnpm room:init が自動で行う)。
# アップストリームは .example のみを出荷する (vercel.json.example と同じ方式)。
#
# シークレットは wrangler.toml に書かず、以下で登録する:
#   pnpm -C servers/room exec wrangler secret put REALTIME_ROOM_AUTH_SECRET
#   (Next 側 env の REALTIME_ROOM_AUTH_SECRET と同じ値にすること)

name = "room-server"
main = "src/index.ts"
compatibility_date = "2026-07-01"

# アプリ側 API へのコールバック (永続化エスケープハッチ) の宛先。
# 本番アプリの正式オリジンを指定する (未設定なら callback effect は無効)。
[vars]
APP_BASE_URL = ""

[[durable_objects.bindings]]
name = "ROOM"
class_name = "RoomDurableObject"

# SQLite-backed Durable Objects (無料プランでも利用可)
[[migrations]]
tag = "v1"
new_sqlite_classes = ["RoomDurableObject"]
