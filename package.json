{
  "name": "nextjs-app-template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "pnpm check --gate=build && next build && pnpm check --gate=build:post",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "node scripts/runner/test/run.mjs",
    "check": "node scripts/runner/gates/run.mjs check",
    "generate": "node scripts/runner/gates/run.mjs generate",
    "task": "npx tsx --import ./scripts/runner/preload/serverOnly.mjs scripts/runner/task/run.ts",
    "ops": "node scripts/runner/entries/run.mjs operations",
    "workflow": "node scripts/runner/entries/run.mjs workflow",
    "forge": "node scripts/structure/forge/run.mjs",
    "e2e": "playwright test -c playwright.config.default.ts",
    "db:push": "npx tsx --import ./scripts/runner/preload/serverOnly.mjs scripts/operations/db/push.ts",
    "db:push:check": "npx tsx --import ./scripts/runner/preload/serverOnly.mjs scripts/operations/db/check-schema-roundtrip.ts",
    "live": "npx tsx scripts/operations/deploy/app.ts",
    "live:app": "npx tsx scripts/operations/deploy/app.ts",
    "live:room": "npx tsx scripts/operations/deploy/room.ts",
    "live:all": "npx tsx scripts/operations/deploy/all.ts"
  },
  "engines": {
    "node": "24"
  },
  "packageManager": "pnpm@10.26.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@firebase/util",
      "@parcel/watcher",
      "esbuild",
      "msw",
      "protobufjs",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "sharp": "^0.35.5"
    },
